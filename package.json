{
  "name": "@webship.co/workspace-git",
  "version": "1.0.0-rc1",
  "description": "Git for Webship Workspace: the GIT menu on every project row (the read-only commands as lingering terminal sessions, the mutating ones to copy, git init where there is no repository) and the filemode command in the site workspaces.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-git.git"
  },
  "files": [
    "dist/src",
    "commands",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "git",
    "label": "Git",
    "commands": {
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "projects",
        "products"
      ],
      "files": [
        "commands/cmd-tools-git-change-filemode-to-false.sh"
      ]
    },
    "features": [
      "features/git.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.0-rc1",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
