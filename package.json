{
  "name": "@webship/workspace-git",
  "version": "1.0.0",
  "description": "Git for Webship Workspace: the GIT menu on every project row (the read-only commands as lingering terminal sessions, the mutating ones to copy, git init where there is no repository) and the filemode command in the site workspaces.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "private": true,
  "license": "ISC",
  "repository": "github:webship/workspace-git",
  "files": ["dist/src", "commands", "features", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "git",
    "label": "Git",
    "commands": { "workspaces": ["dev", "test", "sandboxes", "projects", "products"], "files": ["commands/cmd-tools-git-change-filemode-to-false.sh"] },
    "features": ["features/git.feature"]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship/workspace-plugin-api": "github:webship/workspace-plugin-api#1.0.x",
    "typescript": "^5.9.0"
  }
}
