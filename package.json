{
  "name": "@webship.co/workspace-git",
  "version": "1.0.12",
  "description": "Git for Webship Workspace: the GIT menu on every project row (the read-only commands as lingering terminal sessions, the mutating ones to copy, git init where there is no repository) and the filemode command in the site workspaces. It carries its AI items, each placed in the workspace folder of its kind: an agent, a skill, a command and a prompt.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-git.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "git",
    "label": "Git",
    "needs": [
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "suggests": [
      [
        "dev",
        "test",
        "sandboxes",
        "projects",
        "products"
      ]
    ],
    "commands": {
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "projects",
        "products"
      ],
      "files": [
        "commands/cmd-tools-git-change-filemode-to-false.sh"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/git-state-reader.md"
      ],
      "skills": [
        "ai/skills/git-menu"
      ],
      "commands": [
        "ai/commands/git-state.md"
      ],
      "prompts": [
        "ai/prompts/git-folder-report.md"
      ]
    },
    "features": [
      "features/git.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
